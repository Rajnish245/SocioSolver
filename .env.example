# SocioSolve Environment Configuration
# Copy this file to .env and configure your values

# Django Settings
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-secure-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Optional PostgreSQL. If empty, local SQLite db.sqlite3 will be used)
# Format: postgresql://user:password@localhost:5432/sociosolve
DATABASE_URL=

# Mistral AI Integration
# Set your Mistral API key here. If omitted, AI features will display an informative guidance message.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
AI_RATE_LIMIT_PER_USER_PER_HOUR=15
